# Copy this file to .env and fill in real values. Never commit .env.

# Each person gets their own password. Whichever password is typed in
# determines the display name attached to their messages.
PASSWORD_A=change-me-a
NAME_A=Ajeet
PASSWORD_B=change-me-b
NAME_B=Friend

# Long random string used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Port the server listens on. Render sets this automatically in production.
PORT=3000

# Set to "production" on Render (Render sets this for you). Leave unset
# for local development so cookies work over plain http://localhost.
NODE_ENV=development

# Push notifications (optional -- the chat works fine without these, you
# just won't get notified of new messages). Generate a keypair ONCE with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Keep the same keys across every deploy -- changing them invalidates
# everyone's existing subscription and they'd need to re-enable notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
